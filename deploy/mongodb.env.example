MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=esp_diag
MONGO_ROOT_USERNAME=esp_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MONGO_USERNAME=esp_app
MONGO_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
ESP_API_TOKEN=REPLACE_WITH_RANDOM_BROWSER_API_TOKEN
ESP_API_HOST=127.0.0.1
ESP_API_PORT=8080
# 0 keeps history indefinitely; positive values enable TTL cleanup.
ESP_HISTORY_DAYS=0
ESP_BACKEND_STATE=var/backend/inbox.sqlite3
# Browser database manager; distinct from the MongoDB application account.
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=REPLACE_WITH_RANDOM_MANAGER_PASSWORD
MONGO_EXPRESS_COOKIESECRET=REPLACE_WITH_RANDOM_COOKIE_SECRET
MONGO_EXPRESS_SESSIONSECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
# Local demo only; production MQTT credentials come from the selected config's *_env.
ESP_DEMO_MQTT_PASSWORD=esp32-bdi-test
# Docker MQTT bindings must match config/demo.json (container ports stay fixed).
MQTT_PORT=18883
MQTT_WS_PORT=9001
MQTT_USERNAME=esp32
MQTT_TOPIC_ROOT=h3c
# Production: replace demo MQTT settings with a read-only archive identity.
# ESP_ARCHIVE_MQTT_USERNAME=archive-readonly
# ESP_ARCHIVE_MQTT_PASSWORD=replace-readonly-archive-password
# Optional remote deployment (also set MONGO_DATABASE):
# MONGODB_URI=mongodb://app:password@mongo.example.com/esp_diag?authSource=esp_diag&tls=true
