# Copy to deploy/.env.native (git-ignored), chmod 600, and replace each secret.
# Set this to the broker host's actual LAN address; it must be reachable by ESP.
MQTT_BIND_ADDRESS=192.168.10.10
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TOPIC_ROOT=esp-switch
ESP_DEVICE_MQTT_USERNAME=esp-device
ESP_DEVICE_MQTT_PASSWORD=REPLACE_WITH_RANDOM_DEVICE_PASSWORD
ESP_ARCHIVE_MQTT_USERNAME=archive-readonly
ESP_ARCHIVE_MQTT_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_PASSWORD
ESP_DASHBOARD_MQTT_USERNAME=dashboard-readonly
ESP_DASHBOARD_MQTT_PASSWORD=REPLACE_WITH_RANDOM_DASHBOARD_PASSWORD
# Backend connects through the same explicit LAN binding.
ESP_ARCHIVE_MQTT_HOST=192.168.10.10
ESP_ARCHIVE_MQTT_PORT=1883
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=esp_diag_native
MONGO_ROOT_USERNAME=esp_native_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MONGO_USERNAME=esp_native_app
MONGO_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
ESP_API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN_AT_LEAST_32_CHARACTERS
ESP_API_HOST=127.0.0.1
ESP_API_PORT=8080
ESP_HISTORY_DAYS=0
ESP_BACKEND_STATE=var/backend-native/inbox.sqlite3
# Optional reference explanations; device AI/BDI always run independently.
ESP_AI_PROVIDER=disabled
# ESP_AI_PROVIDER=ollama
# ESP_AI_BASE_URL=http://127.0.0.1:11434
# ESP_AI_MODEL=your-installed-model
# ESP_AI_TIMEOUT_SECONDS=15
# ESP_AI_API_KEY=optional-provider-key
