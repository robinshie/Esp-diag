# Copy to gateway.env (ignored by Git), set actual values, restrict file permissions.
# The web account must have subscribe-only access; it is exported to browser config.
MQTT_GATEWAY_PASSWORD=replace-gateway-password
MQTT_WEB_PASSWORD=replace-readonly-password
SSH_ACCESS01_PASSWORD=replace-device-password
# Use the same ESP_API_TOKEN as mongodb.env when exporting the browser config.
ESP_API_TOKEN=replace-api-token-at-least-32-characters
